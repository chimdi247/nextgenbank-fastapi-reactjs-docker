# ──────────────────────────────────────────────────────────────────────────────
# Template. Copy to .envs/.env.local (a ready-to-run .env.local is already provided for local development).
# ──────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=local
PROJECT_NAME=NextGen Bank
PROJECT_DESCRIPTION=NextGen Bank API
SITE_NAME=NextGen Bank
API_V1_STR=/api/v1
# Links in activation / password-reset e-mails are built from this (nginx forwards them to the web UI)
API_BASE_URL=http://localhost:8088
FRONTEND_URL=http://localhost:8088
MAILPIT_PUBLIC_URL=http://localhost:8025
SUPPORT_EMAIL=support@nextgenbank.local

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=nextgen
POSTGRES_PASSWORD=nextgen_pw
POSTGRES_DB=nextgen
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# The application talks to PgBouncer (transaction pooling); Alembic uses the direct connection.
DATABASE_URL=postgresql+asyncpg://nextgen:nextgen_pw@pgbouncer:6432/nextgen
DATABASE_DIRECT_URL=postgresql+asyncpg://nextgen:nextgen_pw@postgres:5432/nextgen
DB_USE_PGBOUNCER=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Mail (Mailpit catches everything: http://localhost:8025) ───────────────────
MAIL_FROM=no-reply@nextgenbank.local
MAIL_FROM_NAME=NextGen Bank
SMTP_HOST=mailpit
SMTP_PORT=1025

# ── Redis / RabbitMQ / Celery ─────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_FLOWER_USER=admin
CELERY_FLOWER_PASSWORD=admin
CELERY_CONCURRENCY=2

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=local-dev-jwt-secret-change-me-0123456789abcdef
SIGNING_KEY=local-dev-signing-key-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
COOKIE_SECURE=false
LOGIN_ATTEMPTS=5

# ── Banking rules ─────────────────────────────────────────────────────────────
BANK_CODE=420
BANK_BRANCH_CODE=100
MAX_BANK_ACCOUNTS=3

# Every rate limit is multiplied by this (1 = production limits). Raised so the UI, tests and load tests
# are not throttled; set to 1 to see the real limits.
RATE_LIMIT_MULTIPLIER=20

# ── Cloudinary (optional: only profile / ID photo uploads need it) ────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── MLflow (fraud model tracking) ─────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:4000
MLFLOW_BACKEND_STORE_URI=sqlite:////mlflow/mlflow.db
MLFLOW_ARTIFACTS_DESTINATION=/mlflow/artifacts

# ── OpenTelemetry (traces -> Tempo, metrics -> Prometheus, logs -> Loki via the collector) ──
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_PYTHON_LOG_CORRELATION=true
